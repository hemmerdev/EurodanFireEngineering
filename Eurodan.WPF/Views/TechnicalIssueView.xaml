<UserControl x:Class="Eurodan.WPF.Views.TechnicalIssueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Eurodan.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#202020" Foreground="#EEEEEE">

    <Grid>
        <TextBlock Text="Technical Issue Management"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="10" />

        <StackPanel>
            <DataGrid Style="{StaticResource ManagementDataGridStyle}"
                      Margin="10,70,10,3"
                      ItemsSource="{Binding TechnicalIssues}"
                      SelectedItem="{Binding SelectedIssue}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      MaxHeight="350">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                    <DataGridTextColumn Header="Description"
                                        Binding="{Binding Description}"
                                        Width="*"
                                        ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Required fields are marked with an asterisk -->
            <TextBlock Text="Required fields are marked with an asterisk (*)"
                       FontSize="12"
                       Foreground="#AAAAAA"
                       Margin="10,0,0,12" />

            <TextBlock Text="Name *" Margin="10,0,10,3"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputTextBoxStyle}"
                     MaxLength="150"
                     Margin="10,0,10,12"/>

            <TextBlock Text="Description" Margin="10,0,10,3"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputTextBoxStyle}"
                     MaxLength="500"
                     Margin="10,0,10,12"/>

            <WrapPanel>
                <Button Content="Add issue" Command="{Binding AddIssueCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="10,0,8,0"/>

                <Button Content="Save changes" Command="{Binding UpdateIssueCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="10,0,8,0"/>

                <Button Content="Delete" Command="{Binding DeleteIssueCommand}"
                        Style="{StaticResource WarningButtonStyle}"
                        Margin="10,0,8,0"/>
            </WrapPanel>

            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource MessageTextStyle}"
                       Foreground="#AAAAAA"
                       TextWrapping="Wrap"
                       Margin="10,12,10,0"/>
        </StackPanel>

    </Grid>
</UserControl>
