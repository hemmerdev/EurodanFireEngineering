<UserControl x:Class="Eurodan.WPF.Views.ClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Eurodan.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#202020" Foreground="#EEEEEE">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <TextBlock Text="Client Management"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="10"/>

                <StackPanel>
                    <DataGrid Style="{StaticResource ManagementDataGridStyle}"
                              Margin="10,70,10,12"
                              ItemsSource="{Binding Clients}"
                              SelectedItem="{Binding SelectedClient}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              MaxHeight="350">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Company"
                                                Binding="{Binding CompanyName}"
                                                ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                            <DataGridTextColumn Header="Contact"
                                                Binding="{Binding ContactName}"
                                                ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                            <DataGridTextColumn Header="Email"
                                                Binding="{Binding Email}"
                                                Width="500"
                                                ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                            <DataGridTextColumn Header="Phone"
                                                Binding="{Binding Phone}"
                                                ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Heading for the client registration form -->
                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Margin="10,12,10,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Register New Client"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Text" Value="Edit Client"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Required fields are marked with an asterisk -->
                    <TextBlock Text="Required fields are marked with an asterisk (*)"
                               FontSize="12"
                               Foreground="#AAAAAA"
                               Margin="10,0,0,12"/>

                    <TextBlock Text="Company name *" Margin="10,0,10,3"/>
                    <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="10,0,10,12"
                             MaxLength="150"/>

                    <TextBlock Text="Contact name" Margin="10,0,10,3"/>
                    <TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="10,0,10,12"
                             MaxLength="100"/>

                    <TextBlock Text="Email" Margin="10,0,10,3"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="10,0,10,12"
                             MaxLength="254"/>

                    <TextBlock Text="Phone" Margin="10,0,10,3"/>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="10,0,10,12"
                             MaxLength="30"/>

                    <!-- Registration buttons-->
                    <WrapPanel>
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>

                        <Button Content="Register client"
                                Command="{Binding RegisterClientCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="10,0,8,0"/>

                        <Button Content="Clear form"
                                Command="{Binding ClearClientFormCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="0,0,8,0"/>
                    </WrapPanel>

                    <!-- Editing buttons-->
                    <WrapPanel>
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>

                        <Button Content="Update client"
                                Command="{Binding UpdateClientCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="10,0,8,0"/>

                        <Button Content="Cancel editing"
                                Command="{Binding ClearClientFormCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="0,0,8,0"/>

                        <Button Content="Delete client"
                                Command="{Binding DeleteClientCommand}"
                                Style="{StaticResource WarningButtonStyle}"
                                Margin="0,0,8,0"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Status message -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource MessageTextStyle}"
                   Foreground="#EEEEEE"
                   TextWrapping="Wrap"
                   Margin="10,8,10,10"/>
    </Grid>
</UserControl>