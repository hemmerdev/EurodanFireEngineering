<UserControl x:Class="Eurodan.WPF.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="#202020"
             Foreground="#EEEEEE">

    <Grid>
        <!-- Project Creation form-->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="10">

                    <TextBlock Text="Project Management"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,0,0,20" />

                    <!-- Required fields are marked with an asterisk -->
                    <TextBlock Text="Required fields are marked with an asterisk (*)"
                               FontSize="12"
                               Foreground="#AAAAAA"
                               Margin="0,0,0,12" />

                    <TextBlock Text="Project number *"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding ProjectNumber, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="30"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Project name *"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="200"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Project Manager"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding ProjectManager, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Building Surveyor"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding BuildingSurveyor, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Fee proposal amount"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding FeeProposalText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Invoiced amount"
                               Margin="0,0,0,4" />
                    <TextBox  Text="{Binding InvoicedAmountText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Outstanding amount"
                               Margin="0,0,0,4" />
                    <TextBox  Text="{Binding OutstandingAmountText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Payment due date"
                               Margin="0,0,0,4"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <DatePicker SelectedDate="{Binding SelectedPaymentDueDate, Mode=TwoWay}"
                                    SelectedDateFormat="Short"
                                    Style="{StaticResource InputDatePickerStyle}"/>

                        <Button Grid.Column="1"
                                Content="Clear"
                                Command="{Binding ClearPaymentDueDateCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="8,0,0,0"/>
                    </Grid>

                    <TextBlock Text="Fee Proposal Status *"
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding FeeProposalStatuses}"
                              SelectedItem="{Binding SelectedFeeProposalStatus, Mode=TwoWay}"
                              Style="{StaticResource InputComboBoxStyle}"
                              Margin="0,0,0,12" />

                    <!-- PBDB status -->
                    <TextBlock Text="PBDB status"
                               Margin="0,0,0,4" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox ItemsSource="{Binding CompletionStatuses}"
                                  SelectedItem="{Binding SelectedPbdbStatus, Mode=TwoWay}"
                                  Style="{StaticResource InputComboBoxStyle}"/>

                        <Button Grid.Column="1"
                                Content="Clear"
                                Command="{Binding ClearPbdbStatusCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="8,0,0,0"/>
                    </Grid>

                    <!-- FSER Status-->
                    <TextBlock Text="FSER status"
                               Margin="0,0,0,4" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox ItemsSource="{Binding CompletionStatuses}"
                                  SelectedItem="{Binding SelectedFserStatus, Mode=TwoWay}"
                                  Style="{StaticResource InputComboBoxStyle}"/>

                        <Button Grid.Column="1"
                                Content="Clear"
                                Command="{Binding ClearFserStatusCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Client dropdown-->
                    <TextBlock Text="Client *"
                               Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Clients}"
                              DisplayMemberPath="CompanyName"
                              SelectedValuePath="ClientId"
                              SelectedValue="{Binding SelectedClientId, Mode=TwoWay}"
                              Style="{StaticResource InputComboBoxStyle}"
                              Margin="0,0,0,12" />

                    <!-- Building options -->
                    <TextBlock Text="Buildings * (Select at least one)"
                               Margin="0,0,0,8" />

                    <ScrollViewer MaxHeight="250"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl ItemsSource="{Binding BuildingOptions}"
                                      Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Style="{StaticResource FilterCheckBoxStyle}"
                                              Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Building.Name}"
                                                       TextWrapping="Wrap" />

                                            <TextBlock Text="{Binding Building.Address}"
                                                       Foreground="#AAAAAA"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Building Classes -->
                    <TextBlock Text="Building Classes"
                               Margin="0,0,0,8" />

                    <ScrollViewer MaxHeight="250"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding BuildingClassOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              ToolTip="{Binding BuildingClass.Description}"
                                              Style="{StaticResource FilterCheckBoxStyle}"
                                              Margin="0,0,0,8">

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Class code - "
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding BuildingClass.ClassCode}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Technical Issues -->
                    <TextBlock Text="Technical issues"
                               Margin="0,12,0,8" />

                    <ScrollViewer MaxHeight="250"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding TechnicalIssueOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              ToolTip="{Binding TechnicalIssue.Description}"
                                              Style="{StaticResource FilterCheckBoxStyle}"
                                              Margin="0,0,0,8">
                                        <TextBlock Text="{Binding TechnicalIssue.Name}"
                                                   TextWrapping="Wrap" />
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="Comments"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding Comments, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             Height="100"
                             Style="{StaticResource InputTextBoxStyle}"
                             Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save project"
                                Command="{Binding SaveProjectCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0" />

                        <Button Content="Clear form"
                                Command="{Binding ClearProjectFormCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="12,12,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource MessageTextStyle}"
                               Foreground="#AAAAAA"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                </StackPanel>
                <!-- Empty column for spacing -->
                <!-- TODO: Fix this temporary solution with better UI/UX design -->
                <Grid Grid.Column="1"
                      Background="Transparent"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>