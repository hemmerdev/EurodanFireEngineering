<UserControl x:Class="Eurodan.WPF.Views.ClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Eurodan.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#202020" Foreground="#EEEEEE">
    <Grid>
        <TextBlock Text="Client Management"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="10" />

        <StackPanel>
            <DataGrid Style="{StaticResource ManagementDataGridStyle}"
                      Margin="10,70,10,12"
                      ItemsSource="{Binding Clients}"
                      SelectedItem="{Binding SelectedClient}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      MaxHeight="350">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Company"
                                        Binding="{Binding CompanyName}"
                                        ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                    <DataGridTextColumn Header="Contact"
                                        Binding="{Binding ContactName}"
                                        ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding Email}"
                                        Width="*"
                                        ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                    <DataGridTextColumn Header="Phone"
                                        Binding="{Binding Phone}"
                                        ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Company name" Margin="10,0,10,3"/>
            <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputTextBoxStyle}"
                     Margin="10,0,10,12"/>

            <TextBlock Text="Contact name" Margin="10,0,10,3"/>
            <TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputTextBoxStyle}"
                     Margin="10,0,10,12"/>

            <TextBlock Text="Email" Margin="10,0,10,3"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputTextBoxStyle}"
                     Margin="10,0,10,12"/>

            <TextBlock Text="Phone" Margin="10,0,10,3"/>
            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputTextBoxStyle}"
                     Margin="10,0,10,12"/>

            <WrapPanel>
                <Button Content="Register client" Command="{Binding RegisterClientCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="10,0,8,0"/>
                <Button Content="Save changes" Command="{Binding UpdateClientCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0,0,8,0"/>
            </WrapPanel>

            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource MessageTextStyle}"
                       Foreground="#AAAAAA"
                       TextWrapping="Wrap"
                       Margin="10,12,10,0"/>

        </StackPanel>
    </Grid>
</UserControl>
