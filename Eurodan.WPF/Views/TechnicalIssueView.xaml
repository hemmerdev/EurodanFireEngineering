<UserControl x:Class="Eurodan.WPF.Views.TechnicalIssueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Eurodan.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#202020" Foreground="#EEEEEE">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <TextBlock Text="Technical Issue Management"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="10"/>

                <StackPanel>
                    <DataGrid Style="{StaticResource ManagementDataGridStyle}"
                              Margin="10,70,10,3"
                              ItemsSource="{Binding TechnicalIssues}"
                              SelectedItem="{Binding SelectedIssue}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              MaxHeight="350">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding Name}"
                                                ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding Description}"
                                                Width="*"
                                                ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Heading for the issue registration form -->
                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Margin="10,12,10,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Register new Technical Issue"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Text" Value="Edit Technical Issue"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Required fields are marked with an asterisk -->
                    <TextBlock Text="Required fields are marked with an asterisk (*)"
                               FontSize="12"
                               Foreground="#AAAAAA"
                               Margin="10,0,0,12"/>

                    <TextBlock Text="Name *" Margin="10,0,10,3"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             MaxLength="150"
                             Margin="10,0,10,12"/>

                    <TextBlock Text="Description" Margin="10,0,10,3"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBoxStyle}"
                             MaxLength="500"
                             Margin="10,0,10,12"/>

                    <!-- Registration buttons-->
                    <WrapPanel>
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>

                        <Button Content="Add issue"
                                Command="{Binding AddIssueCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="10,0,8,0"/>

                        <Button Content="Clear form"
                                Command="{Binding ClearIssueFormCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="0,0,8,0"/>
                    </WrapPanel>

                    <!-- Editing buttons -->
                    <WrapPanel>
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>

                        <Button Content="Update issue"
                                Command="{Binding UpdateIssueCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="10,0,8,0"/>

                        <Button Content="Cancel editing"
                                Command="{Binding ClearIssueFormCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="0,0,8,0"/>

                        <Button Content="Delete issue"
                                Command="{Binding DeleteIssueCommand}"
                                Style="{StaticResource WarningButtonStyle}"
                                Margin="0,0,8,0"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource MessageTextStyle}"
                   Foreground="#EEEEEE"
                   TextWrapping="Wrap"
                   Margin="10,8,10,10"/>
    </Grid>
</UserControl>