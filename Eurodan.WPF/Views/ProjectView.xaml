<UserControl x:Class="Eurodan.WPF.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="#202020"
             Foreground="#EEEEEE">

    <Grid>
        <!-- Project Creation form-->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10">

                <TextBlock Text="Project Management"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20" />

                <TextBlock Text="Project number"
                           Margin="0,0,0,4" />

                <TextBox Text="{Binding ProjectNumber, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="30"
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,0,12" />

                <TextBlock Text="Project name"
                           Margin="0,0,0,4" />

                <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="200"
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,0,12" />

                <TextBlock Text="Client"
                           Margin="0,0,0,4" />

                <!-- Client dropdown-->
                <ComboBox ItemsSource="{Binding Clients}"
                          DisplayMemberPath="CompanyName"
                          SelectedValuePath="ClientId"
                          SelectedValue="{Binding SelectedClientId, Mode=TwoWay}"
                          Style="{StaticResource InputComboBoxStyle}"
                          Margin="0,0,0,12" />

                <!-- Building options -->
                <TextBlock Text="Buildings (select at least one)"
                           Margin="0,0,0,8" />

                <ScrollViewer MaxHeight="250"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl ItemsSource="{Binding BuildingOptions}"
                                  Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Style="{StaticResource FilterCheckBoxStyle}"
                                          Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Building.Name}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Text="{Binding Building.Address}"
                                                   Foreground="#AAAAAA"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Building Classes -->
                <TextBlock Text="Building Classes (optional)"
                           Margin="0,0,0,8" />

                <ScrollViewer MaxHeight="250"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding BuildingClassOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          ToolTip="{Binding BuildingClass.Description}"
                                          Style="{StaticResource FilterCheckBoxStyle}"
                                          Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Class code - "
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding BuildingClass.ClassCode}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Technical Issues -->
                <TextBlock Text="Technical issues (optional)"
                           Margin="0,12,0,8" />

                <ScrollViewer MaxHeight="250"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding TechnicalIssueOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          ToolTip="{Binding TechnicalIssue.Description}"
                                          Style="{StaticResource FilterCheckBoxStyle}"
                                          Margin="0,0,0,8">
                                    <TextBlock Text="{Binding TechnicalIssue.Name}"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Content="Save project"
                        Command="{Binding SaveProjectCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,0" />

                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource MessageTextStyle}"
                           Foreground="#AAAAAA"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>