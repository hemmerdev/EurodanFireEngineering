<UserControl x:Class="Eurodan.WPF.Views.BuildingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Eurodan.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#202020" Foreground="#EEEEEE">
    <Grid>
        <TextBlock Text="Building Management"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="10" />

        <Button Content="Register new building"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Style="{StaticResource PrimaryButtonStyle}"
                Margin="10,66,0,0"
                Command="{Binding DataContext.ShowBuildingRegistrationCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>


    </Grid>
</UserControl>
