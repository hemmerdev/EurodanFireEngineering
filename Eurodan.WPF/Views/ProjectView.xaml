<UserControl x:Class="Eurodan.WPF.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="#202020"
             Foreground="#EEEEEE">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10">

                <TextBlock Text="Project Management"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20" />

                <TextBlock Text="Project number"
                           Margin="0,0,0,4" />

                <TextBox Text="{Binding ProjectNumber, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="30"
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,0,12" />

                <TextBlock Text="Project name"
                           Margin="0,0,0,4" />

                <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="200"
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,0,12" />

                <TextBlock Text="Client"
                           Margin="0,0,0,4" />

                <ComboBox ItemsSource="{Binding Clients}"
                          DisplayMemberPath="CompanyName"
                          SelectedValuePath="ClientId"
                          SelectedValue="{Binding SelectedClientId, Mode=TwoWay}"
                          Style="{StaticResource InputComboBoxStyle}"
                          Margin="0,0,0,12" />

                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource MessageTextStyle}"
                           Foreground="#AAAAAA"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>