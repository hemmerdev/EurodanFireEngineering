<UserControl x:Class="Eurodan.WPF.Views.BuildingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Eurodan.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#202020" Foreground="#EEEEEE">
    <Grid>
        <TextBlock Text="Building Management"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="10" />

        <StackPanel>
            <DataGrid Style="{StaticResource ManagementDataGridStyle}"
                      Margin="10,70,10,12"
                      ItemsSource="{Binding Buildings}"
                      SelectedItem="{Binding SelectedBuilding}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      MaxHeight="350">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        ElementStyle="{StaticResource ManagementCellTextStyle}"/>
                    <DataGridTextColumn Header="Address"
                                        Binding="{Binding Address}"
                                        ElementStyle="{StaticResource ManagementCellTextStyle}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Heading for the building registration form-->
            <TextBlock FontSize="18"
                       FontWeight="Bold"
                       Margin="10,12,10,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Register New Building"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Text" Value="Edit Building"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Required fields are marked with an asterisk -->
            <TextBlock Text="Required fields are marked with an asterisk (*)"
                       FontSize="12"
                       Foreground="#AAAAAA"
                       Margin="10,0,0,12" />

            <TextBlock Text="Name *" Margin="10,0,10,3"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="150" Style="{StaticResource InputTextBoxStyle}"
                     Margin="10,0,10,12"/>

            <TextBlock Text="Address *" Margin="10,0,10,3"/>
            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputTextBoxStyle}"
                     Margin="10,0,10,12"
                     MaxLength="250"/>

            <!-- Registration buttons-->
            <WrapPanel>
                <WrapPanel.Style>
                    <Style TargetType="WrapPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </WrapPanel.Style>

                <Button Content="Register building"
                        Command="{Binding RegisterBuildingCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="10,0,8,0"/>

                <Button Content="Clear form"
                        Command="{Binding ClearBuildingFormCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0,0,8,0"/>
            </WrapPanel>

            <!-- Editing Buttons-->
            <WrapPanel>
                <WrapPanel.Style>
                    <Style TargetType="WrapPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </WrapPanel.Style>

                <Button Content="Update building"
                        Command="{Binding UpdateBuildingCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="10,0,8,0"/>

                <Button Content="Cancel editing"
                        Command="{Binding ClearBuildingFormCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0,0,8,0"/>

                <Button Content="Delete building"
                        Command="{Binding DeleteBuildingCommand}"
                        Style="{StaticResource WarningButtonStyle}"
                        Margin="0,0,8,0"/>
            </WrapPanel>

            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource MessageTextStyle}"
                       Foreground="#AAAAAA"
                       TextWrapping="Wrap"
                       Margin="10,12,10,0"/>

        </StackPanel>
    </Grid>
</UserControl>
