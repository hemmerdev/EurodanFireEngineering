<UserControl x:Class="Eurodan.WPF.Views.ProjectDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Eurodan.WPF.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Keep the heading and Close button visible while the details scroll. -->
        <DockPanel Grid.Row="0"
                   LastChildFill="True"
                   Margin="0,0,0,20">
            <!-- The Close command belongs to MainViewModel on the containing window. -->
            <Button DockPanel.Dock="Right"
                    Content="X"
                    Command="{Binding DataContext.CloseProjectDetailsCommand,
                    RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource ActionButtonStyle}"
                    MinWidth="36"
                    ToolTip="Close project details" />

            <Button DockPanel.Dock="Right"
                    Content="Edit"
                    Command="{Binding DataContext.OpenProjectFormForEditingCommand,
                    RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding SelectedProject.ProjectId}"
                    Style="{StaticResource ActionButtonStyle}"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding IsSelectedProjectActive}"/>

            <!-- Archive and Restore swap places based on the project's state. Their commands live
            on this panel's own ViewModel, so no RelativeSource is needed -->

            <Button DockPanel.Dock="Right"
                    Content="Archive"
                    Command="{Binding ArchiveProjectCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    Margin="0,0,8,0"
                    Visibility="{Binding IsSelectedProjectActive, Converter={StaticResource BoolToVisibility}}"/>

            <Button DockPanel.Dock="Right"
                    Content="Restore"
                    Command="{Binding RestoreProjectCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    Margin="0,0,8,0"
                    Visibility="{Binding IsSelectedProjectArchived, Converter={StaticResource BoolToVisibility}}"/>

            <TextBlock Text="Project details"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="This project is archived. Restore it to edit."
                           Margin="0,0,0,20"
                           Visibility="{Binding IsSelectedProjectArchived, Converter={StaticResource BoolToVisibility}}"/>

                <TextBlock Text="Company name"
                           Margin="0,0,0,3" />
                <TextBlock Text="{Binding SelectedClient.CompanyName}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <TextBlock Text="Contact name"
                           Margin="0,0,0,3" />
                <TextBlock Text="{Binding SelectedClient.ContactName}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <TextBlock Text="Phone"
                           Margin="0,0,0,3" />
                <TextBlock Text="{Binding SelectedClient.Phone}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <TextBlock Text="Email"
                           Margin="0,0,0,3" />
                <TextBlock Text="{Binding SelectedClient.Email}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <TextBlock Text="Comments"
                           Margin="0,0,0,3" />
                <TextBlock Text="{Binding SelectedProject.Comments}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource MessageTextStyle}"
                           Foreground="#AAAAAA"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
