<UserControl x:Class="Eurodan.WPF.Views.ProjectOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Eurodan.WPF.Views"
             xmlns:enums="clr-namespace:Eurodan.WPF.ViewModels.enums"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#202020" Foreground="#EEEEEE">

    <UserControl.Resources>
        <Style x:Key="OverviewCellTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource ManagementCellTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="8,6" />
            <Setter Property="ToolTip"
                    Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Project Overview"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Project Search -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Search by project name or number"
                           Margin="0,0,0,6" />

                <TextBox Text="{Binding ProjectSearchText,
                         Mode=TwoWay,
                         UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBoxStyle}" />
            </StackPanel>

            <!-- Client Search -->
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="Search by client name"
                           Margin="0,0,0,6" />

                <TextBox Text="{Binding ClientSearchText,
                         Mode=TwoWay,
                         UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputTextBoxStyle}" />
            </StackPanel>

            <!-- Technical issues dropdown -->
            <Grid Grid.Column="2"
                  Width="140"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Margin="0,0,12,0">
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Search by issue"
                               Margin="0,0,0,6" />

                    <ToggleButton x:Name="TechnicalIssueFilterButton"
                                  Style="{StaticResource FilterDropdownButtonStyle}">
                        <DockPanel LastChildFill="True">

                            <TextBlock DockPanel.Dock="Right"
                                       Text="▾"
                                       FontSize="10"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" />

                            <TextBlock Text="Technical issues"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </ToggleButton>
                </StackPanel>

                <Popup Placement="Bottom"
                       PlacementTarget="{Binding ElementName=TechnicalIssueFilterButton}"
                       IsOpen="{Binding IsChecked,
                       ElementName=TechnicalIssueFilterButton,
                       Mode=TwoWay}"
                       DataContext="{Binding PlacementTarget.DataContext,
                       RelativeSource={RelativeSource Self}}"
                       StaysOpen="False"
                       AllowsTransparency="True">

                    <Border Width="340"
                            Background="#333333"
                            BorderBrush="#595959"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="10">

                        <StackPanel>
                            <TextBlock Text="Projects must match all selected issues"
                                       Foreground="#EEEEEE"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="Search by issue name"
                                       Margin="0,0,0,4"/>

                            <TextBox Text="{Binding TechnicalIssueSearchText,
                                     UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Margin="0,0,0,8"
                                     MinHeight="25"
                                     Padding="8,3"/>

                            <ScrollViewer MaxHeight="200"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">

                                <ItemsControl ItemsSource="{Binding FilteredTechnicalIssueOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected,
                                                      Mode=TwoWay}"
                                                      ToolTip="{Binding TechnicalIssue.Description}"
                                                      Style="{StaticResource FilterCheckBoxStyle}"
                                                      Margin="0,0,0,8">

                                                <TextBlock Text="{Binding TechnicalIssue.Name}"
                                                           TextWrapping="Wrap" />
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- UC05: Archived projects are hidden by default; ticking this adds them back.
            TwoWay, so ticking it updates the ViewModel. -->
            <StackPanel Grid.Column="3"
                        VerticalAlignment="Bottom"
                        MinHeight="36"
                        Margin="0,0,12,0">

                <CheckBox Content="Show active projects"
                          IsChecked="{Binding ShowActiveProjects,
                          Mode=TwoWay}"
                          Style="{StaticResource FilterCheckBoxStyle}"
                          VerticalAlignment="Center"
                          Margin="0,0,0,4" />

                <CheckBox Content="Show archived projects"
                          IsChecked="{Binding ShowArchivedProjects,
                          Mode=TwoWay}"
                          Style="{StaticResource FilterCheckBoxStyle}"
                          VerticalAlignment="Center" />

            </StackPanel>

            <!-- Payment status filter-->
            <StackPanel Grid.Column="4"
                        Width="145"
                        VerticalAlignment="Bottom">
                <TextBlock Text="Search by payment status"
                           Margin="0,0,0,6"/>

                <ComboBox ItemsSource="{Binding PaymentStatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                          Style="{StaticResource InputComboBoxStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding}"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}"
                                                         Value="{x:Static enums:PaymentStatusFilter.NotPaid}">
                                                <Setter Property="Text" Value="Not paid"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding}"
                                                         Value="{x:Static enums:PaymentStatusFilter.NotSpecified}">
                                                <Setter Property="Text" Value="Not specified"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Projects}"
                  SelectedItem="{Binding SelectedProjectRow}"
                  Style="{StaticResource ManagementDataGridStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  FrozenColumnCount="1"
                  CanUserResizeColumns="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                  GridLinesVisibility="All"
                  VerticalGridLinesBrush="#505050">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Project number"
                                    Binding="{Binding Project.ProjectNumber}"
                                    Width="140"
                                    ElementStyle="{StaticResource OverviewCellTextStyle}" />

                <DataGridTextColumn Header="Project name"
                                    Binding="{Binding Project.ProjectName}"
                                    Width="260" MinWidth="220"
                                    ElementStyle="{StaticResource OverviewCellTextStyle}" />

                <DataGridTextColumn Header="Client"
                                    Binding="{Binding ClientCompanyName}"
                                    Width="200"
                                    ElementStyle="{StaticResource OverviewCellTextStyle}" />

                <DataGridTextColumn Header="Buildings"
                                    Binding="{Binding BuildingNames}"
                                    Width="220"
                                    ElementStyle="{StaticResource OverviewCellTextStyle}" />

                <DataGridTextColumn Header="Building classes"
                                    Binding="{Binding BuildingClassCodes}"
                                    Width="140"
                                    ElementStyle="{StaticResource OverviewCellTextStyle}" />

                <DataGridTextColumn Header="Technical issues"
                                    Binding="{Binding TechnicalIssueNames}"
                                    Width="260"
                                    ElementStyle="{StaticResource OverviewCellTextStyle}" />

                <DataGridTextColumn Header="Project manager"
                                    Binding="{Binding Project.ProjectManager}"
                                    Width="180" MinWidth="160"
                                    ElementStyle="{StaticResource OverviewCellTextStyle}" />

                <DataGridTextColumn Header="Building surveyor"
                                    Binding="{Binding Project.BuildingSurveyor}"
                                    Width="180"
                                    ElementStyle="{StaticResource OverviewCellTextStyle}" />

                <DataGridTextColumn Header="Fee proposal status"
                                    Binding="{Binding Project.FeeProposalStatus}"
                                    Width="160"
                                    ElementStyle="{StaticResource OverviewCellTextStyle}" />

                <DataGridTextColumn Header="PBDB status"
                                    Binding="{Binding Project.PbdbStatus}"
                                    Width="140"
                                    ElementStyle="{StaticResource OverviewCellTextStyle}" />

                <DataGridTextColumn Header="FSER status"
                                    Binding="{Binding Project.FserStatus}"
                                    Width="140"
                                    ElementStyle="{StaticResource OverviewCellTextStyle}" />

                <DataGridTextColumn Header="Fee proposal amount"
                                    Binding="{Binding Project.FeeProposal,
                                    StringFormat={}{0:N2}, ConverterCulture=en-AU}"
                                    Width="160"
                                    ElementStyle="{StaticResource OverviewCellTextStyle}" />

                <DataGridTextColumn Header="Invoiced amount"
                                    Binding="{Binding Project.InvoicedAmount,
                                    StringFormat={}{0:N2}, ConverterCulture=en-AU}"
                                    Width="150"
                                    ElementStyle="{StaticResource OverviewCellTextStyle}" />

                <DataGridTextColumn Header="Outstanding amount"
                                    Binding="{Binding Project.OutstandingAmount,
                                    StringFormat={}{0:N2}, ConverterCulture=en-AU}"
                                    Width="170"
                                    ElementStyle="{StaticResource OverviewCellTextStyle}" />

                <!-- Payment status column -->
                <DataGridTemplateColumn Header="Payment status"
                                        HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                        Width="145">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="PaymentStatusPill"
                                    Width="112"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="#49422E"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="6,4">
                                <TextBlock x:Name="PaymentStatusText"
                                           Text="Not paid"
                                           Foreground="#E6CF8E"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Green pill when paid  -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Project.IsPaid}"
                                             Value="True">
                                    <Setter TargetName="PaymentStatusText"
                                            Property="Text"
                                            Value="Paid"/>
                                    <Setter TargetName="PaymentStatusPill"
                                            Property="Background"
                                            Value="#2F4635"/>
                                    <Setter TargetName="PaymentStatusText"
                                            Property="Foreground"
                                            Value="#B7DDBE"/>
                                </DataTrigger>

                                <!-- Show "Not specified" pill when invoiced amount or outstanding amount is missing -->
                                <DataTrigger Binding="{Binding Project.InvoicedAmount}"
                                             Value="{x:Null}">
                                    <Setter TargetName="PaymentStatusText"
                                            Property="Text"
                                            Value="Not specified"/>
                                    <Setter TargetName="PaymentStatusPill"
                                            Property="Background"
                                            Value="#3A3A3A"/>
                                    <Setter TargetName="PaymentStatusText"
                                            Property="Foreground"
                                            Value="#CCCCCC"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Project.OutstandingAmount}"
                                             Value="{x:Null}">
                                    <Setter TargetName="PaymentStatusText"
                                            Property="Text"
                                            Value="Not specified"/>
                                    <Setter TargetName="PaymentStatusPill"
                                            Property="Background"
                                            Value="#3A3A3A"/>
                                    <Setter TargetName="PaymentStatusText"
                                            Property="Foreground"
                                            Value="#CCCCCC"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Shows which rows are archived when "Show archived projects" is ticked. -->
                <DataGridTemplateColumn Header="Archive status"
                                        HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                        Width="125">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="ArchiveStatusPill"
                                    Width="88"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="#2F4635"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="6,4">
                                <TextBlock x:Name="ArchiveStatusText"
                                           Text="Active"
                                           Foreground="#B7DDBE"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Project.IsArchived}"
                                             Value="True">
                                    <Setter TargetName="ArchiveStatusText"
                                            Property="Text"
                                            Value="Archived"/>
                                    <Setter TargetName="ArchiveStatusPill"
                                            Property="Background"
                                            Value="#3A3A3A"/>
                                    <Setter TargetName="ArchiveStatusText"
                                            Property="Foreground"
                                            Value="#CCCCCC"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Payment due date"
                                    Binding="{Binding Project.PaymentDueDate, StringFormat={}{0:dd/MM/yyyy}}"
                                    Width="160"
                                    ElementStyle="{StaticResource OverviewCellTextStyle}" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource MessageTextStyle}"
                   Foreground="#AAAAAA"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />

        <!-- Display the existing Details ViewModel below the project list. -->
        <ContentControl Grid.Row="4"
                        Content="{Binding DataContext.ProjectDetails,
                        RelativeSource={RelativeSource AncestorType=Window}}"
                        HorizontalContentAlignment="Stretch"
                        MaxHeight="300"
                        Margin="0,12,0,0">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <!-- Hide the panel when no project row is selected. -->
                        <DataTrigger Binding="{Binding SelectedProjectRow}"
                                     Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</UserControl>
