<UserControl x:Class="Eurodan.WPF.Views.ProjectDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Eurodan.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Project details"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20" />

                    <TextBlock Text="Company name"
                       Margin="0,0,0,3" />
                    <TextBlock Text="{Binding SelectedClient.CompanyName}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

                    <TextBlock Text="Contact name"
                       Margin="0,0,0,3" />
                    <TextBlock Text="{Binding SelectedClient.ContactName}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

                    <TextBlock Text="Phone"
                       Margin="0,0,0,3" />
                    <TextBlock Text="{Binding SelectedClient.Phone}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

                    <TextBlock Text="Email"
                       Margin="0,0,0,3" />
                    <TextBlock Text="{Binding SelectedClient.Email}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

                    <TextBlock Text="Comments"
                       Margin="0,0,0,3" />
                    <TextBlock Text="{Binding SelectedProject.Comments}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

                    <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource MessageTextStyle}"
                       Foreground="#AAAAAA"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
</UserControl>
